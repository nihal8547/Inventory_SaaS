# Application
NODE_ENV=development
APP_NAME="Inventory SaaS"

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Backend
PORT=3001
API_PREFIX=api/v1

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_saas
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/inventory_saas

# Redis
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRY=7d
REFRESH_TOKEN_SECRET=your-refresh-token-secret-change-in-production
REFRESH_TOKEN_EXPIRY=30d

# Encryption
ENCRYPTION_KEY=your-32-char-encryption-key-here!!

# S3 / Object Storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=inventory-saas
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_REGION=us-east-1

# Email
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@inventorysaas.com

# Webhook
WEBHOOK_SIGNING_SECRET=your-webhook-signing-secret

# SaaS Admin
SUPER_ADMIN_EMAIL=admin@inventorysaas.com
SUPER_ADMIN_PASSWORD=Admin@123456

# Rate Limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
